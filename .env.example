# ============================================================
# ProgramMind 环境配置示例
# 使用方法：复制本文件为 .env，再按需修改。
# .env 已被 .gitignore 排除，敏感信息不要提交到仓库。
# ============================================================


# ============================================================
# Embedding 模型
# ============================================================

EMBEDDING_MODEL=BAAI/bge-m3


# ============================================================
# 运行设备（cpu / cuda，大小写均可）
# ============================================================

DEVICE=cuda


# ============================================================
# Qwen 本地模型
# ============================================================

QWEN_MODEL_PATH=./models/Qwen/Qwen2.5-7B-Instruct


# ============================================================
# 默认模型
# ============================================================

MODEL_TYPE=deepseek

MODEL_PATH=./models/Qwen/Qwen2.5-7B-Instruct


# ============================================================
# DeepSeek
# ============================================================

DEEPSEEK_MODEL=deepseek-chat

# 在 https://platform.deepseek.com 申请
DEEPSEEK_API_KEY=sk-你的密钥


# ============================================================
# PostgreSQL / PGVector（知识库向量检索）
# ============================================================

PGVECTOR_HOST=localhost

PGVECTOR_PORT=5432

PGVECTOR_DATABASE=programmind

# 兼容旧配置，与 PGVECTOR_DATABASE 保持一致
PGVECTOR_DB=programmind

PGVECTOR_USER=postgres

PGVECTOR_PASSWORD=你的postgres密码


# ============================================================
# 业务数据库（database/postgres.py 使用）
# ============================================================

POSTGRES_HOST=localhost

POSTGRES_PORT=5432

POSTGRES_DB=programmind

POSTGRES_USER=postgres

POSTGRES_PASSWORD=123456


# ============================================================
# Web 服务
# ============================================================

# 0.0.0.0 = 局域网其他电脑可访问
HOST=0.0.0.0

PORT=8000

# start_dev.bat 会自动置为 true（热重载仅限开发）
RELOAD=false

# ============================================================
# ProgramMind Demo Web 层（backend/ + frontend/，本次新增）
# 说明：以下均为示例值或占位符，请勿写入真实密钥后提交仓库。
# ============================================================

# ---- Demo 调用的正式 ProgramMind AI 服务（RAG）----

PROGRAMMIND_RAG_BASE_URL=http://127.0.0.1:8000

# 首次检索需加载 bge-m3，超时建议不低于 60 秒
PROGRAMMIND_RAG_TIMEOUT=60

PROGRAMMIND_RAG_TOP_K=5


# ---- Demo 自带的大模型适配层（默认 0 = Mock，保证零依赖演示）----

PROGRAMMIND_LLM_ENABLED=0

PROGRAMMIND_LLM_BASE_URL=http://localhost:11434/v1

PROGRAMMIND_LLM_MODEL=qwen2.5:7b

# 占位符（非真实密钥）：Ollama 对 Authorization 字段不做校验
PROGRAMMIND_LLM_API_KEY=ollama

PROGRAMMIND_LLM_MAX_TOKENS=2048

PROGRAMMIND_LLM_TIMEOUT=120


# ---- Demo 后端 Session 签名密钥（部署时替换为自己的随机字符串）----

PROGRAMMIND_SECRET=change-me-to-a-random-string
